D Dec 31 2024 (744)\neom_ratio_9m = 51.31          # Expense of Management to NWP ratio YTD Dec 31 2024\n\nprint(\"GWP 9M (Cr):\", gwp_9m_lakhs/100)\nprint(\"NWP 9M (Cr):\", nwp_9m_lakhs/100)\nprint(\"Net worth (Cr):\", net_worth_lakhs/100)\nprint(\"PAT IGAAP 9M (Cr):\", pat_igaap_9m_lakhs/100)\nprint(\"EoM ratio 9M:\", eom_ratio_9m, \"%\")\n\n# NEP - from Segment reporting Annexure II - Net Earned Premium YTD Dec 31 2024 (sum of Health + PA + Travel), Rs Lakhs\nnep_health = 329763\nnep_pa = 6317\nnep_travel = 624\nnep_total_lakhs = nep_health + nep_pa + nep_travel\nprint(\"NEP 9M (Cr):\", nep_total_lakhs/100)\n\n# From Q3FY25 Press Release:\ngwp_9m_press_cr = 5011   # \"For first 9 months... GWP of \u20b95011cr\" -- this is EX-1/n (like-to-like) basis\ngwp_9m_1n_cr = 4684      # \"With '1/n' the GWP for 9M FY25 is 4684cr\" -- STATUTORY 1/n basis (matches disclosure 4683.58)\npat_9m_press = None      # 9M PAT IGAAP not explicitly given in press release; Q3 standalone PAT = 13.2 cr Y-o-Y +189%\nretail_market_share_9mfy25 = 9.6   # 9.6% (vs 9.0% 9MFY24) per press release\n\nprint(\"GWP 9M like-to-like (Cr):\", gwp_9m_press_cr)\nprint(\"GWP 9M statutory 1/n (Cr):\", gwp_9m_1n_cr)\nprint(\"Retail health market share 9MFY25:\", retail_market_share_9mfy25, \"%\")\n\n# Cross check: statutory disclosure GWP 4683.58 Cr vs press release 1/n GWP 4684 Cr -> MATCH (rounding)\nprint(\"\\nCross-check GWP match:\", abs(gwp_9m_lakhs/100 - gwp_9m_1n_cr) < 1)\n", "result": "\"GWP 9M (Cr): 4683.58\\nNWP 9M (Cr): 3697.32\\nNet worth (Cr): 2868.84\\nPAT IGAAP 9M (Cr): 7.44\\nEoM ratio 9M: 51.31 %\\nNEP 9M (Cr): 3367.04\\nGWP 9M like-to-like (Cr): 5011\\nGWP 9M statutory 1/n (Cr): 4684\\nRetail health market share 9MFY25: 9.6 %\\n\\nCross-check GWP match: True\\n\""}}}</sources>
