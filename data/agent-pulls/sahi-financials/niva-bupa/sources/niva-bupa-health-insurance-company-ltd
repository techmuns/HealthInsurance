  window.trackFeatureExplored = function (featureName, category, ticker) {
    if (!window.mixpanel) return;
    var explored = new Set(
      JSON.parse(window.sessionStorage.getItem("explored_features") || "[]"),
    );
    if (explored.has(featureName)) return;
    explored.add(featureName);
    window.sessionStorage.setItem(
      "explored_features",
      JSON.stringify(Array.from(explored)),
    );
    window.mixpanel.track("feature_explored", {
      feature_name: featureName,
      feature_category: category,
      company_ticker: ticker || "",
      session_feature_count: explored.size,
    });
    if (window.django && window.django.user && window.django.user.id) {
      window.mixpanel.people.union("features_used", [featureName]);
    }
  };
</script>




