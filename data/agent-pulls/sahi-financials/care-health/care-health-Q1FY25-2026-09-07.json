plots\n\n# Data\nmetrics = ['Claims Ratio', 'Expense Ratio (EoM/NWP)', 'EoM Ratio (EoM/GDPI)', 'Commission Ratio', 'Combined Ratio']\nq1fy24 = [56, 36, 36, 16, 92]\nq1fy25 = [67, 34, 35, 17, 101]\n\nfig = go.Figure()\nfig.add_trace(go.Bar(name='Q1 FY24', x=metrics, y=q1fy24, marker_color='#7fa8d9', text=q1fy24, textposition='outside'))\nfig.add_trace(go.Bar(name='Q1 FY25', x=metrics, y=q1fy25, marker_color='#d9534f', text=q1fy25, textposition='outside'))\n\nfig.update_layout(\n    title='Care Health Insurance Ltd \u2014 Key IGAAP Ratios: Q1FY24 vs Q1FY25 (Statutory NL-20 Disclosure)',\n    yaxis_title='Percentage (%)',\n    barmode='group',\n    template='plotly_white',\n    legend=dict(orientation='h', yanchor='bottom', y=1.02, xanchor='right', x=1)\n)\n\nprint({'is_graph': True, 'filename': ['chart1'], 'json_data': {'chart1': fig.to_json()}})\n", "result": "{\"is_graph\": true, \"filename\": [\"chart1\"], \"created_files\": {\"chart1\": \"success\"}, \"creation_status\": \"success\"}"}}}</sources>
