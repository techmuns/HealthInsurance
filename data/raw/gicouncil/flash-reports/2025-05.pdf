olid fa-arrow-right"></i></a></div></swiper-slide><swiper-slide _ngcontent-ng-c876220805><div _ngcontent-ng-c876220805 class="awareness-card"><div _ngcontent-ng-c876220805 class="awareness-card__header"><div _ngcontent-ng-c876220805 class="awareness-card__icon"><img _ngcontent-ng-c876220805 src="Images/Home/6.png" alt="Insured Declared Value"><!----><!----></div><h3 _ngcontent-ng-c876220805 class="awareness-card__title">Insured Declared Value</h3></div><div _ngcontent-ng-c876220805 class="awareness-card__body"><p _ngcontent-ng-c876220805 class="awareness-card__desc"> IDV is the maximum Sum Assured payable by the insurer on total loss of vehicle. </p></div><a _ngcontent-ng-c876220805 class="awareness-card__link" href="https://idv.gicouncil.in/">Read More <i _ngcontent-ng-c876220805 class="fa-solid fa-arrow-right"></i></a></div></swiper-slide><swiper-slide _ngcontent-ng-c876220805><div _ngcontent-ng-c876220805 class="awareness-card"><div _ngcontent-ng-c876220805 class="awareness-card__header"><div _ngcontent-ng-c876220805 class="awareness-card__icon"><!----><i _ngcontent-ng-c876220805 class="fa-solid"></i><!----></div><h3 _ngcontent-ng-c876220805 class="awareness-card__title">Electronic Transaction Administration and Settlement System</h3></div><div _ngcontent-ng-c876220805 class="awareness-card__body"><p _ngcontent-ng-c876220805 class="awareness-card__desc"> The ETASS project has been envisaged as a platform to bring in transparency and ease of settlements ... </p></div><a _ngcontent-ng-c876220805 class="awareness-card__link" href="etass">Read More <i _ngcontent-ng-c876220805 class="fa-solid fa-arrow-right"></i></a></div></swiper-slide><swiper-slide _ngcontent-ng-c876220805><div _ngcontent-ng-c876220805 class="awareness-card"><div _ngcontent-ng-c876220805 class="awareness-card__header"><div _ngcontent-ng-c876220805 class="awareness-card__icon"><!----><i _ngcontent-ng-c876220805 class="fa-solid"></i><!----></div><h3 _ngcontent-ng-c876220805 class="awareness-card__title">Pradhan Mantri Suraksha Bima Yojana</h3></div><div _ngcontent-ng-c876220805 class="awareness-card__body"><p _ngcontent-ng-c876220805 class="awareness-card__desc"> Pradhan Mantri Suraksha Bima Yojana was started by the Ministry of Finance in 2015-16 to provide ins... </p></div><a _ngcontent-ng-c876220805 class="awareness-card__link" href="pmsby">Read More <i _ngcontent-ng-c876220805 class="fa-solid fa-arrow-right"></i></a></div></swiper-slide><swiper-slide _ngcontent-ng-c876220805><div _ngcontent-ng-c876220805 class="awareness-card"><div _ngcontent-ng-c876220805 class="awareness-card__header"><div _ngcontent-ng-c876220805 class="awareness-card__icon"><img _ngcontent-ng-c876220805 src="Images/Home/fraud.jpg" alt="Fraud Risk Management"><!----><!----></div><h3 _ngcontent-ng-c876220805 class="awareness-card__title">Fraud Risk Management</h3></div><div _ngcontent-ng-c876220805 class="awareness-card__body"><p _ngcontent-ng-c876220805 class="awareness-card__desc"> Pradhan Mantri Suraksha Bima Yojana was started by the Ministry of Finance in 2015-16 to provide ins... </p></div><a _ngcontent-ng-c876220805 class="awareness-card__link" href="frmp">Read More <i _ngcontent-ng-c876220805 class="fa-solid fa-arrow-right"></i></a></div></swiper-slide><!----></swiper-container></div></div></section><section _ngcontent-ng-c876220805 aria-label="GIC Year Book" class="vision-banner_2"><div _ngcontent-ng-c876220805 class="container vision-banner__inner"><div _ngcontent-ng-c876220805 class="vision-banner__icon vision-banner__icon_1"><i _ngcontent-ng-c876220805 class="fa-solid fa-flag"></i></div><div _ngcontent-ng-c876220805 class="vision-banner__text"><h2 _ngcontent-ng-c876220805 class="vision-banner__title vision-banner__icon_1">GIC Year Book 2024–25</h2><p _ngcontent-ng-c876220805 class="vision-banner__subtitle vision-banner__icon_1"> Discover GIC's achievements, industry insights, financial performance, and key initiatives driving growth and resilience in the insurance sector. Explore our commitment to strengthening India's risk protection ecosystem. </p></div><div _ngcontent-ng-c876220805 class="vision-banner__actions"><a _ngcontent-ng-c876220805 href="/Year-Book/GIC_Yearbook_2024-25.pdf" target="_blank" rel="noopener noreferrer" class="vision-banner__btn vision-banner__btn--primary"> Explore Report </a></div></div></section><section _ngcontent-ng-c876220805 aria-label="Publications and reports" class="publications-section"><div _ngcontent-ng-c876220805 class="container"><div _ngcontent-ng-c876220805 class="pub-header"><h2 _ngcontent-ng-c876220805 class="section-title"><i _ngcontent-ng-c876220805 class="fa-solid fa-book-open"></i> What is New </h2><a _ngcontent-ng-c876220805 href="gic-events" target="_blank" rel="noopener noreferrer" class="btn-outline">Explore News <i _ngcontent-ng-c876220805 class="fa-solid fa-arrow-right"></i></a></div><div _ngcontent-ng-c876220805 role="search" class="search-bar"><i _ngcontent-ng-c876220805 aria-hidden="true" class="fa-solid fa-magnifying-glass search-bar__icon"></i><input _ngcontent-ng-c876220805 type="text" placeholder="Search publications by title or description..." aria-label="Search publications" class="search-bar__input" value><!----></div><!----><div _ngcontent-ng-c876220805 class="pub-grid"><div _ngcontent-ng-c876220805 class="pub-card"><div _ngcontent-ng-c876220805 class="pub-card__cover" aria-label="Insurer-hospital panel"><div _ngcontent-ng-c876220805 class="pub-card__cover-bg"><img _ngcontent-ng-c876220805 class="pub-card__cover-icon" src="Images/About-Us/Dr_Prakash.jpg" alt="Insurer-hospital panel"><span _ngcontent-ng-c876220805 class="pub-card__year"></span></div></div><div _ngcontent-ng-c876220805 class="pub-card__body"><h3 _ngcontent-ng-c876220805 class="pub-card__title">Insurer-hospital panel</h3><p _ngcontent-ng-c876220805 class="pub-card__desc">Insurer-hospital panel on the cards to resolve disputes, says General Insurance Council CEO</p><a _ngcontent-ng-c876220805 target="_blank" class="pub-card__download" href="/gic-events/12"><i _ngcontent-ng-c876220805 class="fa-solid fa-arrow-right"></i> Read More </a></div></div><div _ngcontent-ng-c876220805 class="pub-card"><div _ngcontent-ng-c876220805 class="pub-card__cover" aria-label="GI Council defends fever admission advisory"><div _ngcontent-ng-c876220805 class="pub-card__cover-bg"><img _ngcontent-ng-c876220805 class="pub-card__cover-icon" src="Images/About-Us/prakash-sir-pic.jpeg" alt="GI Council defends fever admission advisory"><span _ngcontent-ng-c876220805 class="pub-card__year"></span></div></div><div _ngcontent-ng-c876220805 class="pub-card__body"><h3 _ngcontent-ng-c876220805 class="pub-card__title">GI Council defends fever admission advisory</h3><p _ngcontent-ng-c876220805 class="pub-card__desc">Between 2019 and 2024, unnecessary hospital admissions have surged dramatically. Data shows Rs 94,247.6 crore in total health claims settled in 2024-25, with cashless-only admissions accounting for 66.4 per cent of the volume.</p><a _ngcontent-ng-c876220805 target="_blank" class="pub-card__download" href="/gic-events/11"><i _ngcontent-ng-c876220805 class="fa-solid fa-arrow-right"></i> Read More </a></div></div><div _ngcontent-ng-c876220805 class="pub-card"><div _ngcontent-ng-c876220805 class="pub-card__cover" aria-label="Hidden Stress of Healthcare "><div _ngcontent-ng-c876220805 class="pub-card__cover-bg"><img _ngcontent-ng-c876220805 class="pub-card__cover-icon" src="Images/About-Us/Dr_Prakash.jpg" alt="Hidden Stress of Healthcare "><span _ngcontent-ng-c876220805 class="pub-card__year"></span></div></div><div _ngcontent-ng-c876220805 class="pub-card__body"><h3 _ngcontent-ng-c876220805 class="pub-card__title">Hidden Stress of Healthcare </h3><p _ngcontent-ng-c876220805 class="pub-card__desc">Hidden Stress of Healthcare: When Patients Get Caught Between Hospitals, Insurers</p><a _ngcontent-ng-c876220805 target="_blank" class="pub-card__download" href="/gic-events/10"><i _ngcontent-ng-c876220805 class="fa-solid fa-arrow-right"></i> Read More </a></div></div><div _ngcontent-ng-c876220805 class="pub-card"><div _ngcontent-ng-c876220805 class="pub-card__cover" aria-label="Efficiency Financing and Technology Adoption "><div _ngcontent-ng-c876220805 class="pub-card__cover-bg"><img _ngcontent-ng-c876220805 class="pub-card__cover-icon" src="Images/Events/image_(1).jpeg" alt="Efficiency Financing and Technology Adoption "><span _ngcontent-ng-c876220805 class="pub-card__year"></span></div></div><div _ngcontent-ng-c876220805 class="pub-card__body"><h3 _ngcontent-ng-c876220805 class="pub-card__title">Efficiency Financing and Technology Adoption </h3><p _ngcontent-ng-c876220805 class="pub-card__desc">A seminar on  Energy Efficiency Financing and Technology Adoption for MSMEs under ADEETIE and launch of the Energy Savings Insurance Roadmap of India was held at Fairfield by Marriot, Andheri (West), Mumbai on 15th &amp; 16th July 2026.</p><a _ngcontent-ng-c876220805 target="_blank" class="pub-card__download" href="/gic-events/9"><i _ngcontent-ng-c876220805 class="fa-solid fa-arrow-right"></i> Read More </a></div></div><div _ngcontent-ng-c876220805 class="pub-card"><div _ngcontent-ng-c876220805 class="pub-card__cover" aria-label="H.E.L.P. (Health &amp; Environment Leadership Platform) International Summit 2026"><div _ngcontent-ng-c876220805 class="pub-card__cover-bg"><img _ngcontent-ng-c876220805 class="pub-card__cover-icon" src="https://www.gicouncil.in/media/4674/image_001.jpeg" alt="H.E.L.P. (Health &amp; Environment Leadership Platform) International Summit 2026"><span _ngcontent-ng-c876220805 class="pub-card__year"></span></div></div><div _ngcontent-ng-c876220805 class="pub-card__body"><h3 _ngcontent-ng-c876220805 class="pub-card__title">H.E.L.P. (Health &amp; Environment Leadership Platform) International Summit 2026</h3><p _ngcontent-ng-c876220805 class="pub-card__desc">Honoured to speak at the H.E.L.P. (Health &amp; Environment Leadership Platform) Internatoinal Summit 2026 at Yashoda Hospitals, Hyderabad on 20 June 2026.</p><a _ngcontent-ng-c876220805 target="_blank" class="pub-card__download" href="/gic-events/1"><i _ngcontent-ng-c876220805 class="fa-solid fa-arrow-right"></i> Read More </a></div></div><!----></div><nav _ngcontent-ng-c876220805 role="navigation" aria-label="Publications pagination" class="pagination"><button _ngcontent-ng-c876220805 type="button" aria-label="Previous page" class="pagination__btn" disabled><i _ngcontent-ng-c876220805 class="fa-solid fa-chevron-left"></i></button><button _ngcontent-ng-c876220805 type="button" class="pagination__btn pagination__btn--num pagination__btn--active" aria-current="page"> 1 </button><button _ngcontent-ng-c876220805 type="button" class="pagination__btn pagination__btn--num"> 2 </button><button _ngcontent-ng-c876220805 type="button" class="pagination__btn pagination__btn--num"> 3 </button><!----><button _ngcontent-ng-c876220805 type="button" aria-label="Next page" class="pagination__btn"><i _ngcontent-ng-c876220805 class="fa-solid fa-chevron-right"></i></button></nav><!----><!----></div></section><section _ngcontent-ng-c876220805 aria-label="GIC Year Book" class="vision-banner_2 vision-banner_3"><div _ngcontent-ng-c876220805 class="container vision-banner__inner"><div _ngcontent-ng-c876220805 class="vision-banner__icon vision-banner__icon_1"><i _ngcontent-ng-c876220805 class="fa-solid fa-flag"></i></div><div _ngcontent-ng-c876220805 class="vision-banner__text"><h2 _ngcontent-ng-c876220805 class="vision-banner__title vision-banner__icon_1">GIC Council Newsletter</h2><p _ngcontent-ng-c876220805 class="vision-banner__subtitle vision-banner__icon_1"> Highlights from India and across the world. </p></div><div _ngcontent-ng-c876220805 class="vision-banner__actions"><a _ngcontent-ng-c876220805 href="gic-council-newsletter" target="_blank" class="vision-banner__btn vision-banner__btn--primary">Explore Newsletter</a></div></div></section><section _ngcontent-ng-c876220805 class="contai